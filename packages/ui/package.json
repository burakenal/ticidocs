{
  "name": "@ticidocs/ui",
  "version": "0.1.0",
  "description": "Ticidocs documentation UI components",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./docs-shell": {
      "types": "./src/docs-shell.tsx",
      "default": "./src/docs-shell.tsx"
    },
    "./markdown-body": {
      "types": "./src/markdown-body.tsx",
      "default": "./src/markdown-body.tsx"
    },
    "./mdx-components": {
      "types": "./src/mdx-components.tsx",
      "default": "./src/mdx-components.tsx"
    },
    "./endpoint-view": {
      "types": "./src/endpoint-view.tsx",
      "default": "./src/endpoint-view.tsx"
    },
    "./try-it": {
      "types": "./src/try-it.tsx",
      "default": "./src/try-it.tsx"
    },
    "./toc": {
      "types": "./src/toc.tsx",
      "default": "./src/toc.tsx"
    },
    "./fallback-banner": {
      "types": "./src/fallback-banner.tsx",
      "default": "./src/fallback-banner.tsx"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --noEmit --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ticidocs/core": "workspace:*",
    "@ticidocs/openapi": "workspace:*",
    "@ticidocs/search": "workspace:*",
    "@ticidocs/theme": "workspace:*"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
